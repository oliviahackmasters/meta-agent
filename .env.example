# Meta-Agent Environment Configuration
# Copy this file to .env and fill in your API keys

# === Web Search ===
# Tavily API key for live web search
# Get your key at: https://tavily.com
TAVILY_API_KEY=

# === News & Information Fetching ===
# NewsAPI key for fetching current news articles
# Get your key at: https://newsapi.org
NEWSAPI_KEY=

# === LLM Providers ===
# OpenAI API key for GPT models
OPENAI_API_KEY=

# Google Gemini API key
GOOGLE_API_KEY=
GEMINI_API_KEY=

# Anthropic Claude API key
ANTHROPIC_API_KEY=

# DeepSeek API key
DEEPSEEK_API_KEY=

# Infomaniak AI API token
INFOMANIAK_API_TOKEN=
INFOMANIAK_PRODUCT_ID=
INFOMANIAK_MODEL=qwen3

# === Optional Configuration ===
# Environment (development/production)
NODE_ENV=development
